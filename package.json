{
    "name": "whatsapp-electron-bot",
    "version": "1.0.0",
    "description": "Chatbot de suporte para WhatsApp com painel administrativo (Electron)",
    "author": "Redenet Soluções em TI <ok.email@exemplo.com>",
    "license": "MIT",
    "main": "src/main/main.js",
    "scripts": {
        "start": "electron .",
        "dev": "nodemon",
        "serve": "node scripts/serve.js",
        "import:csv": "node scripts/import-users-csv.js",
        "test": "node --test",
        "build": "electron-builder",
        "dist": "electron-builder --win",
        "postinstall": "electron-builder install-app-deps"
    },
    "build": {
        "appId": "com.yourcompany.whatsapp-bot",
        "productName": "iEscolar Bot",
        "directories": {
            "output": "dist",
            "buildResources": "build"
        },
        "files": [
            "src/**/*",
            "assets/**/*",
            "package.json",
            "node_modules/**/*",
            "build/**/*",
            "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
            "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
            "!**/node_modules/.bin",
            "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}"
        ],
        "win": {
            "target": "nsis",
            "icon": "./assets/ico.ico",
            "signAndEditExecutable": false,
            "requestedExecutionLevel": "asInvoker"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "perMachine": true,
            "include": "build/installer.nsh"
        },
        "asar": false
    },
    "dependencies": {
        "@fontsource/inter": "^5.0.20",
        "@fortawesome/fontawesome-free": "^6.5.2",
        "bootstrap": "^5.3.3",
        "chart.js": "^4.4.7",
        "csv-parse": "^5.6.0",
        "dotenv": "^16.4.5",
        "exceljs": "^4.4.0",
        "express": "^4.21.2",
        "hydra-bot": "^1.0.33",
        "pdfkit": "^0.15.2",
        "pg": "^8.16.0",
        "pg-hstore": "^2.3.4",
        "sequelize": "^6.37.7",
        "socket.io": "^4.8.1"
    },
    "devDependencies": {
        "electron": "^33.2.0",
        "electron-builder": "^26.0.12",
        "nodemon": "^3.1.10",
        "socket.io-client": "^4.8.1"
    }
}
