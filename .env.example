# Copie para .env e ajuste. O .env NÃO é versionado.
#
# App instalado no Windows: coloque o .env em %APPDATA%\iEscolar Bot\.env

# --- PostgreSQL (obrigatório) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatbot
DB_USER=postgres
DB_PASS=troque_esta_senha
# DB_TIMEZONE=America/Fortaleza   # padrão: fuso do sistema (usado nos gráficos por dia/mês)
# DB_LOGGING=false

# --- Painel / API local ---
# Por padrão só aceita conexões da própria máquina. 0.0.0.0 expõe o painel na rede.
# SERVER_HOST=127.0.0.1
# SERVER_PORT=3000

# --- Bot ---
# BOT_ENABLED=true          # false sobe só o painel, sem abrir o WhatsApp
# BOT_HEADLESS=false        # true esconde a janela do Chrome do WhatsApp Web
# MAX_ACTIVE_CHATS=1        # usuários atendidos ao mesmo tempo antes de formar fila
# BOT_REPLY_DELAY_MS=2000
